lemma bern_LP1 (g k τ s : ℝ) (h0a : (0:ℝ) ≤ g) (h0b : g ≤ (1:ℝ)) (h3a : (0:ℝ) ≤ s) (h3b : s ≤ (1:ℝ)) :
